# ================================================================
# AHLC — Adaptive Hybrid Lossless Compression (.gitignore)
# ================================================================

# ── CMake & Compiler Build Artifacts ────────────────────────────
build/
out/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
_deps/
compile_commands.json
*.ninja
.ninja_*

# MSVC / Visual Studio
*.vcxproj.user
*.vcxproj.filters
*.sln
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.VC.db
*.opendb
*.ipch

# Compiled binaries, object files & link libraries
*.exe
*.dll
*.obj
*.o
*.lib
*.a
*.pdb
*.ilk
*.exp

# vcpkg package manager
vcpkg_installed/
.vcpkg/

# ── Python ───────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
.Python

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Package, test & lint tooling
dist/
.eggs/
*.egg-info/
*.egg
.pytest_cache/
.tox/
htmlcov/
.coverage
.coverage.*
coverage.xml
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
pip-log.txt
pip-delete-this-directory.txt

# ── Flask / AHLC Runtime & Database ──────────────────────────────
# SQLite database (runtime data, not version-controlled)
flask_app/ahlc.db
flask_app/*.db
flask_app/*.db-shm
flask_app/*.db-wal
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Uploaded and processed multimedia files (preserve directory via .gitkeep)
uploads/*
!uploads/.gitkeep
outputs/*
!outputs/.gitkeep
reports/

# Temporary media & test artifacts
*.tmp
__*.bmp
__*.ahmc
__*.wav
__*.bin
__*.avi
__*.mp4
__*.flac
__*.png
bitio_test_tmp.bin
format_test_tmp.bmp
*_tmp_verify.*
*_tmp_*
__verify_tmp.*

# Scratch directory (ignore all generated artifacts, keep Python test scripts)
scratch/*
!scratch/*.py
!scratch/**/.gitkeep

# ── IDEs & Editors ───────────────────────────────────────────────
.vscode/
*.code-workspace
.idea/
*.iml
*.iws

# ── OS Generated Files ───────────────────────────────────────────
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ── Environment & Secrets ────────────────────────────────────────
.env
.env.*
*.log
*.bak
*.swp
*.swo
